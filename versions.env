# Shared LTS / long-support pins for source-compiled logging images.
# Ubuntu 22.04 matches AgentLink / public-service runtime bases.

UBUNTU_VERSION=22.04
UBUNTU_SOURCE_IMAGE="${UBUNTU_SOURCE_IMAGE:-m.daocloud.io/docker.io/library/ubuntu:22.04}"
UBUNTU_APT_MIRROR="${UBUNTU_APT_MIRROR:-repo.huaweicloud.com}"

# OpenJDK 21 LTS. Use the official Temurin linux-x64 binary; do not compile from source.
JDK_VERSION=21.0.12
JDK_BUILD=8
JDK_TAG=jdk-21.0.12+8
JDK_BUILD_IMAGE=local/ai-jdk-build:${JDK_VERSION}
JDK_RUNTIME_IMAGE=local/ai-jdk-runtime:${JDK_VERSION}

# Grafana 12.4.8 and Filebeat 8.19.20 both require Go 1.26.5.
GO_VERSION=1.26.5
GO_BOOTSTRAP_VERSION=1.25.9
GO_TOOLCHAIN_IMAGE=local/ai-go-toolchain:${GO_VERSION}

# Kibana 8.19.20 pins Node 24.18.0. Use the official linux-x64 binary; do not compile from source.
NODE_VERSION=24.18.0
NODE_BUILD_IMAGE=local/ai-node-build:${NODE_VERSION}
NODE_RUNTIME_IMAGE=local/ai-node-runtime:${NODE_VERSION}

# Last Kafka 3.x (KRaft, matches the running 3.9.0 PoC).
KAFKA_VERSION=3.9.2
KAFKA_SCALA_VERSION=2.13

# Last Elastic 8.x (LTS-equivalent 8 line; host currently runs 8.15.3).
ELASTIC_VERSION=8.19.20

# Last Grafana 12 minor: 15 months of patches (practical LTS vs 13.x).
GRAFANA_VERSION=12.4.8

UBUNTU_BUILD_IMAGE=local/ai-ubuntu-build:${UBUNTU_VERSION}
UBUNTU_RUNTIME_IMAGE=local/ai-ubuntu-runtime:${UBUNTU_VERSION}
